# Server-only — Pinata JWT (create one at https://app.pinata.cloud/developers/api-keys)
# Needs pinFileToIPFS + pinJSONToIPFS scopes. Never prefix this with VITE_
# or it will be bundled into client-side JS and leaked to every visitor.
PINATA_JWT=

# Optional: override the public IPFS gateway used to preview uploads.
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# Optional but recommended: dedicated Sepolia RPC (Alchemy/Infura) instead
# of the shared public relay.
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Recommended: comma-separated list of origins allowed to call
# /api/pinata-file and /api/pinata-json, e.g. https://mintora.vercel.app
# Leave empty to skip the check (fine for local dev only).
ALLOWED_ORIGIN=